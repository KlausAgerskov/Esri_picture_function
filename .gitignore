# --- Python ------------------------------------------------------------
# The plugin repository rejects packages that contain these
__pycache__/
*.py[cod]

# Virtual environments, if you make one for linting or tests
.venv/
venv/

# Linters and test runners
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Packaging ---------------------------------------------------------
# Release zips are built from the repository, not stored in it
*.zip
dist/
build/

# --- VS Code -----------------------------------------------------------
# Personal editor settings. Remove the next lines (or use the !-lines
# instead) if the team should share settings or debug configurations.
.vscode/
# !.vscode/settings.json
# !.vscode/launch.json
*.code-workspace

# --- Test material -----------------------------------------------------
# QGIS projects and exported layout pictures used while testing. They may
# hold service URLs, authcfg ids and pictures that should not be public.
*.qgs~
*.qgz~
test_projects/
layout_pictures/

# --- Operating system --------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
